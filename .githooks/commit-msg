#!/bin/sh
# repo-privacy-guard: scan the commit message before the commit is made.
# git passes the message file as $1. Needs Python 3.11+. Blocks the commit if Python
# can't be found (fail closed).
dir=$(dirname "$0")
for py in python3 python py; do
  if command -v "$py" >/dev/null 2>&1 &&
     "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
    exec "$py" "$dir/privacy_guard.py" commit-msg -- "$1"
  fi
done
echo "privacy-guard: commit blocked: Python 3.11 or newer was not found." >&2
echo "Install it, or skip the guard once with: git commit --no-verify" >&2
exit 1
